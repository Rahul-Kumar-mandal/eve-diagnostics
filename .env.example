# Copy this file to .env and adjust as needed.

# Postgres (preferred). Leave unset to fall back to a local SQLite file,
# which is enough for quickly trying the API out.
DATABASE_URL=postgresql+psycopg2://eve:eve_password@localhost:5432/eve_healthcare

JWT_SECRET_KEY=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Shared secret the mock payment provider must send back on webhook calls.
WEBHOOK_SHARED_SECRET=mock_provider_shared_secret
